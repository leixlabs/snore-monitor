# Rust / Cargo build output
/target

# Backup files generated by rustfmt
**/*.rs.bk

# MSVC (Windows) debug symbol files
*.pdb

# Local configuration. The committed template is `config.example.toml`; a real
# `config.toml` is machine-specific and must not be versioned.
/config.toml
.env
.env.*

# Runtime data produced when pointed at a path inside the repo during local dev:
# SQLite WAL sidecars and in-progress WAV recordings (`<name>.wav.partial`).
*.db
*.db-wal
*.db-shm
*.wav.partial

# OS cruft
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
*.swo
*~
